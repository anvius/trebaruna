[Desktop Entry]
Type=Application
Version=1.0
Name=trebaruna
GenericName=Electronic signature
GenericName[es]=Firma electrónica
GenericName[it]=Firma elettronica
GenericName[ca]=Signatura electrònica
GenericName[gl]=Sinatura electrónica
GenericName[eu]=Sinadura elektronikoa
Comment=Sign PDF, XML and any file with CAdES, PAdES or XAdES
Comment[es]=Firma PDF, XML y cualquier fichero con CAdES, PAdES o XAdES
Comment[it]=Firma PDF, XML e qualsiasi file con CAdES, PAdES o XAdES
Comment[ca]=Signa PDF, XML i qualsevol fitxer amb CAdES, PAdES o XAdES
Comment[gl]=Asina PDF, XML e calquera ficheiro con CAdES, PAdES ou XAdES
Comment[eu]=Sinatu PDF, XML eta edozein fitxategi CAdES, PAdES edo XAdES bidez
# %U passes file arguments, trebaruna:// URIs and AutoFirma's afirma:// URIs;
# the app decides which it received. afirma:// opens the approval window.
Exec=trebaruna-desktop %U
Icon=trebaruna
Terminal=false
Categories=Office;Graphics;
MimeType=application/pdf;text/xml;application/xml;x-scheme-handler/trebaruna;x-scheme-handler/afirma;
Keywords=sign;signature;firma;firma digitale;signatura;sinatura;sinadura;pades;cades;xades;pdf;
StartupNotify=true
